pub use groth16_bn254::{self, *}

use std::evm::assert

#[test]
fn test_groth16_bn254_verify_proof() {
    let ok = groth16_bn254::verifyProof(
        a: [
            0x28930e0aeb50e7e3b5f9a54a6abdce99978e00701914dfd4d87f8dc5ea9e1d02,
            0x02c1e99774e679c144aceac4e9fdbc67dc858533d9f49c5933939c89010131b7,
        ],
        b: [
            [
                0x0684d8357689fb95e886a8251db0e142ffdda8032e314750455b9f5ff13159ca,
                0x26189ebc171412019704e808c432062721db66c4a22635f20ed422a2147ad5bf,
            ],
            [
                0x005d309291fd34bef6248c17779114907b6d912a5a02ddae46d902dbd05e2e1c,
                0x01673b4a2e94569e28e23a9ae808b9f92b4d21beca07522f79d16ec419a6e85c,
            ],
        ],
        c: [
            0x25170145c09315e2df3c93d155b39df35434469607b0121a16125224190a596a,
            0x05467081343913d54408694735a8d149578e7cbb3168f2b4283a7fe2861a7a42,
        ],
        input: [0x21],
    )
    assert(ok == true)
}
